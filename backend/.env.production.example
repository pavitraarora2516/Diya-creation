# Database configuration (PostgreSQL target)
DATABASE_URL="REPLACE_WITH_PRODUCTION_POSTGRESQL_URL"

# Server configuration
PORT=5000
NODE_ENV=production

# Security & Sessions
JWT_SECRET="REPLACE_WITH_PRODUCTION_SECURE_JWT_SECRET_256_BITS"
JWT_EXPIRES_IN="1d"

# CORS configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS="https://diyacreation.com,https://www.diyacreation.com,https://admin.diyacreation.com"

# Webhooks & Sandbox Controls
RAZORPAY_WEBHOOK_SECRET="REPLACE_WITH_PRODUCTION_RAZORPAY_WEBHOOK_SECRET"
ALLOW_SANDBOX_WEBHOOK=false

# SMTP / Email Notifications
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=587
SMTP_USER="notifications@diyacreation.com"
SMTP_PASS="REPLACE_WITH_PRODUCTION_SMTP_PASS"
SMTP_FROM='"Diya Creation" <notifications@diyacreation.com>'

# TarqaAI Configuration
TARQAAI_API_KEY="REPLACE_WITH_PRODUCTION_TARQAAI_API_KEY"
TARQAAI_ENDPOINT="https://tarqaai.com/"

# Production Frontend URL
FRONTEND_URL="https://diyacreation.com"

# Payment Gateway Switch
PAYMENTS_ENABLED=false

