# Database configuration (PostgreSQL target)
DATABASE_URL="postgresql://db_user:db_password@localhost:5432/db_name?schema=public"

# Server configuration
PORT=5000
NODE_ENV=development

# Security & Sessions
JWT_SECRET="replace_with_a_long_random_signing_key_at_least_256_bits"
JWT_EXPIRES_IN="1d"

# CORS configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# Webhooks & Sandbox Controls
RAZORPAY_WEBHOOK_SECRET="replace_with_razorpay_webhook_secret_from_dashboard"
ALLOW_SANDBOX_WEBHOOK=true

# SMTP / Email Notifications
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=587
SMTP_USER="notifications@diyacreation.com"
SMTP_PASS="your_secure_smtp_password"
SMTP_FROM='"Diya Creation" <notifications@diyacreation.com>'

# TarqaAI Configuration
TARQAAI_API_KEY="REPLACE_WITH_TARQAAI_API_KEY"
TARQAAI_ENDPOINT="https://tarqaai.com/"

# Production Frontend URL
FRONTEND_URL="http://localhost:3000"

# Payment Gateway Switch
PAYMENTS_ENABLED=true

